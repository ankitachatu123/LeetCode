class Solution {
//Brute Force Approach 
//number of comparisons= time complexity - (n-1)+(n-2)+(n-3)......+1
//This sum is called an arithmetic series and simplifies to: n(n-1)/2 
//for n=4, we will make 4*3/2 =6 comparisons
//Explanation - (0,1)(0,2)(0,3) (1,2)(1,3) (2,3) - //time complexity - O(n^2)
   public int[] twoSum(int[] nums, int target) {
        int[] result = new int[2];
        int len = nums.length;
        for(int i=0; i<len; i++){
            for(int j=i+1; j<len; j++) {
                if(target==nums[i]+nums[j]){
                    result[0]=i; result[1]=j;
                    break;
                }
            }
        } 
        return result;
    }

//Optimized Solution
//trade off space complexity inc. to reduce time complexity
//time complexity - O(n)
    public int[] twoSumOptimized(int[] nums, int target) {
        int[] result = new int[2];
        int len = nums.length;
        Map<Integer, Integer> map = new HashMap<>();
        for(int i=0; i<len; i++){
             int diff = target-nums[i];
            if(map.containsKey(diff)) {
               result[0] = map.get(diff);
               result[1] = i;
            }
          else {
            map.put(nums[i], i);
          } 
        } 
        return result;
    }
}
