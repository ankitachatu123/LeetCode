class Solution {
//Common Prefix are the initial common letters in the word
//This is a brute force solution wherein each letter of a string is compared with subsequent string.
//Time Complexity - m*(n-1) = m is the common prefix 
//ingredient ingredience ingression ingressiveness - (10,9),(9,5),(5,5) = M = length of 1st element
    public String longestCommonPrefixOptimized(String[] strs) {
         if (strs.length == 0) return "";
    StringBuilder prefix = new StringBuilder(strs[0]);
    for (int i = 1; i < strs.length; i++) {
      StringBuilder common = new StringBuilder();
      String current = strs[i];
      for(int x=0; x<current.length() && x<prefix.length(); x++) {
        if(current.charAt(x)==prefix.charAt(x)) {
          common.append(current.charAt(x));
        } else {
          break;
        }
      }
      prefix = common;
    }
    return prefix.toString();
    }

//optimised code
public String longestCommonPrefix(String[] strs) {
    if (strs == null || strs.length == 0) return "";
    String prefix = strs[0];
    for (int i = 1; i < strs.length; i++) {
        while (strs[i].indexOf(prefix) != 0) {
            prefix = prefix.substring(0, prefix.length() - 1);
            if (prefix.isEmpty()) return "";
        }
    }
    return prefix;
}



//Optimized Solution - Divide and Conquer
 public String longestCommonPrefix(String[] strs) {
        return divideProblem(strs, 0, strs.length - 1);
    }

    public String divideProblem(String[] strs, int l, int r) {
        if (l == r)
            return strs[l];
        if (l < r) {
            int mid = l + (r - l) / 2;
            String s1 = divideProblem(strs, l, mid);
            String s2 = divideProblem(strs, mid + 1, r);
            return combineResponse(s1, s2);
        }
        return "";
    }

    public String combineResponse(String s1, String s2) {
        int min = Math.min(s1.length(), s2.length());
        StringBuilder res = new StringBuilder();
        for (int i = 0; i < min; i++) {
            if (s1.charAt(i) != s2.charAt(i))
                break;
            res.append(s1.charAt(i));
        }
        return res.toString();
    }
}
